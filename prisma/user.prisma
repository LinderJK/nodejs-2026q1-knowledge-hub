model User {
  id         String    @id @default(uuid())
  login      String    @unique
  password   String
  refreshTokenHash String?
  role       UserRole  @default(viewer)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  articles   Article[]
  comments   Comment[]
}

enum UserRole {
  admin
  editor
  viewer
}